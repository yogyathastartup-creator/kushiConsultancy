# Frontend Environment Variables - Development
# Copy this file to .env.local for development
# Never commit .env.local to Git - it's ignored in .gitignore
# Configuration is auto-loaded by Vite

# API Configuration
# Must match your backend server URL (port 3001 in development)
VITE_API_URL=http://localhost:3001/api

# Application Settings
# Max file size for CV upload in MB
VITE_MAX_FILE_SIZE=5

# Public contact email shown in the footer and CV page (defaults to madhu@kushiconsultancy.com)
# VITE_CONTACT_EMAIL=madhu@kushiconsultancy.com

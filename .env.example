# Application Configuration
VITE_APP_NAME=Kushi Consultancy
VITE_API_URL=http://localhost:3001/api
VITE_CONTACT_EMAIL=contact@kushiconsultancy.com

# Email Configuration
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Server Email Configuration (for CV upload notifications)
# Custom SMTP (recommended for domain mailboxes like GoDaddy/Zoho/Office365)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=
# Optional overrides
EMAIL_FROM=
EMAIL_TO=

# Provider examples:
# GoDaddy Workspace/Professional Email:
#   EMAIL_HOST=smtpout.secureserver.net
#   EMAIL_PORT=465
#   EMAIL_SECURE=true
# GoDaddy cPanel (shared hosting):
#   EMAIL_HOST=mail.yourdomain.com
#   EMAIL_PORT=465 (or 587)
#   EMAIL_SECURE=true for 465, false for 587 (STARTTLS)
# Microsoft 365:
#   EMAIL_HOST=smtp.office365.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
# Zoho Mail:
#   EMAIL_HOST=smtp.zoho.com
#   EMAIL_PORT=465
#   EMAIL_SECURE=true

# Gmail fallback (if not using custom SMTP):
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# (Requires 2FA + App Password)

# Server Configuration (if backend is added)
PORT=3001
NODE_ENV=development

# Database (if needed)
DATABASE_URL=your_database_connection_string

# Authentication Secrets
JWT_SECRET=your_very_long_random_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_very_long_refresh_secret_key_here_minimum_32_characters
SESSION_SECRET=your_session_secret_key_here

# Admin Credentials (Hashed - DO NOT store plain passwords)
# Use bcrypt to hash: const hash = await bcrypt.hash('yourPassword', 12);
ADMIN_USERNAME_HASH=
ADMIN_PASSWORD_HASH=

# File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Security Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Production Settings (for deployment)
# HTTPS=true
# SECURE_COOKIES=true
# HSTS_MAX_AGE=31536000

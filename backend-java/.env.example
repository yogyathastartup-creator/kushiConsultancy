# Backend Environment Variables for Kushi Consultancy
# IMPORTANT: Never commit this file to Git. It's in .gitignore for security.
# Copy this file to .env and fill in your actual credentials

# Server Configuration (matches application.properties)
SERVER_PORT=3002
SERVER_ADDRESS=0.0.0.0

# CORS Configuration (comma-separated)
# CORS_ORIGINS values come from: app.cors.origins in application.properties
CORS_ORIGINS=http://localhost:5174,http://localhost:4173

# Admin Credentials (from: app.auth.admin.*)
# Used by application for default admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# JWT Configuration (from: app.jwt.*)
# Base64-encoded secrets, must be >= 256-bit
# Generate new: openssl rand -base64 32
JWT_ACCESS_SECRET=your-base64-encoded-access-secret-key-here
JWT_REFRESH_SECRET=your-base64-encoded-refresh-secret-key-here

# SMTP Configuration (from: spring.mail.*)
# Gmail app password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_TO_ADDRESS=recipient@example.com

# File Upload
FILE_UPLOAD_MAX_SIZE=5MB
STORAGE_PATH=/uploads

# Logging
LOGGING_LEVEL=INFO
DEBUG_MODE=false
